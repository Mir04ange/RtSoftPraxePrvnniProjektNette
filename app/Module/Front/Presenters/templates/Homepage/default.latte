{block content}
<div class="homepage-header">
    <h1>BLOG</h1>
    <p>SUROVÉ ČLÁNKY. SILNÝ OBSAH. ŽÁDNÉ KOMPROMISY.</p>

    <div style="text-align: center; margin-bottom: 30px;" n:if="$user->isLoggedIn()">
        <a class="btn" n:href="Edit:create">NAPSAT NOVÝ PŘÍSPĚVEK</a>
    </div>
</div>

<div class="posts-container">
    {foreach $posts as $post}
        <article class="post">
            <div class="post-icon">
                {if $iterator->counter === 1}⚡{elseif $iterator->counter === 2}💥{elseif $iterator->counter === 3}🔥{elseif $iterator->counter === 4}⭐{else}📌{/if}
            </div>

            <div class="post-content">
                <h2>
                    <a n:href="Post:show $post->id">{$post->title}</a>
                </h2>
                <span class="date">{$post->createdAt|date:'j. n. Y'}</span>
                <p class="post-preview">
                    Kliknutím na název si přečtete celý příspěvek a komentáře.
                </p>
                
                {if $user->isLoggedIn()}
                    <div class="post-actions">
                        <a n:href="Edit:edit $post->id">UPRAVIT</a>
                        <a n:href="Edit:delete $post->id" onclick="return confirm('Opravdu chcete smazat tento příspěvek včetně komentářů?')" style="background: var(--color-accent);">SMAZAT</a>
                    </div>
                {/if}
            </div>
        </article>
    {else}
        <article class="post" style="text-align: center; padding: 60px 40px;">
            <p style="font-size: 1.3rem; color: var(--color-black); font-weight: bold; text-transform: uppercase;">
                BUĎ PRVNÍ KDO VYTVOŘÍ PŘÍSPĚVEK!
            </p>
        </article>
    {/foreach}
</div>
