<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="Blog v historickém stylu">
	
	<title>{ifset title}{include title|stripHtml} | {/ifset}Blog</title>

	<link rel="stylesheet" href="{$basePath}/css/style.css">
	<link rel="icon" href="{$basePath}/favicon.ico">
</head>

<body>
	<main class="container">
		{foreach $flashes as $flash}
			<div n:class="alert, 'alert-' . $flash->type" role="alert">
				{$flash->message}
			</div>
		{/foreach}

		{include content}
	</main>

	<!-- Navigace -->
	<nav class="navig">
		<ul>
			<li><a n:href="Homepage:default">Články</a></li>
			{if $user->isLoggedIn()}
				<li><a n:href="Sign:out">Odhlásit ({$user->getIdentity()?->getId()})</a></li>
			{else}
				<li><a n:href="Sign:in">Přihlásit</a></li>
			{/if}
		</ul>
	</nav>

	{block scripts}
	<script src="https://nette.github.io/resources/js/3/netteForms.min.js"></script>
	{/block}
</body>
</html>
