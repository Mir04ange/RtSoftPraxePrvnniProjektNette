<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="Surový blog s neo-brutalismem a odvážným designem">
	
	<title>{ifset title}{include title|stripHtml} | {/ifset}BLOG BRUTAL</title>

	<link rel="stylesheet" href="{$basePath}/css/style.css">
	<link rel="icon" href="{$basePath}/favicon.ico">
</head>

<body>
	<main class="container">
		{foreach $flashes as $flash}
			<div n:class="alert, 'alert-' . $flash->type" role="alert">
				{$flash->message}
			</div>
		{/foreach}

		{include content}
	</main>

	<!-- Navigace -->
	<nav class="navig">
		<ul>
			<li><a n:href="Homepage:default">ČLÁNKY</a></li>
			<li><a n:href="Homepage:help">NÁPOVĚDA</a></li>
			{if $user->isLoggedIn()}
				<li><a n:href="Sign:out">ODHLÁSIT</a></li>
			{else}
				<li><a n:href="Sign:in">PŘIHLÁSIT</a></li>
			{/if}
		</ul>
	</nav>

	{block scripts}
	<script src="https://nette.github.io/resources/js/3/netteForms.min.js"></script>
	<script>
		// Shake animation on click
		document.querySelectorAll('.btn, .post-actions a').forEach(btn => {
			btn.addEventListener('click', function(e) {
				if (!this.href.includes('delete')) {
					this.style.animation = 'none';
					setTimeout(() => {
						this.style.animation = 'shake 0.3s ease-in-out';
					}, 10);
				}
			});
		});

		// Add shake animation
		const style = document.createElement('style');
		style.textContent = `
			@keyframes shake {
				0%, 100% { transform: rotate(0deg) translateX(0); }
				25% { transform: rotate(-2deg) translateX(-5px); }
				50% { transform: rotate(2deg) translateX(5px); }
				75% { transform: rotate(-2deg) translateX(-5px); }
			}
		`;
		document.head.appendChild(style);

		// Parallax tilt on post cards
		const posts = document.querySelectorAll('.post');
		posts.forEach(post => {
			post.addEventListener('mousemove', (e) => {
				const rect = post.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				
				const centerX = rect.width / 2;
				const centerY = rect.height / 2;
				
				const rotateX = (y - centerY) * 0.05;
				const rotateY = (centerX - x) * 0.05;
				
				post.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
			});
			
			post.addEventListener('mouseleave', () => {
				post.style.transform = 'perspective(800px) rotateX(0) rotateY(0) scale(1)';
			});
		});

		// Intersection Observer for lazy animations
		const observerOptions = {
			threshold: 0.1,
			rootMargin: '0px 0px -50px 0px'
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.style.opacity = '1';
					entry.target.style.transform = 'translateX(0)';
				}
			});
		}, observerOptions);

		document.querySelectorAll('.post').forEach(post => {
			observer.observe(post);
		});

		// Random rotation on page load
		window.addEventListener('load', () => {
			document.querySelectorAll('.post').forEach((post, index) => {
				const rotation = (Math.random() - 0.5) * 2;
				post.style.setProperty('--rotation', rotation + 'deg');
			});
		});
	</script>
	{/block}
</body>
</html>
