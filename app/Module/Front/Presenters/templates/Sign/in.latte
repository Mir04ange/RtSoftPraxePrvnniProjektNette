{block content}

<div class="auth-container" style="max-width: 600px; margin: 0 auto;">
    <h1 n:block=title>Přihlášení</h1>
    <p style="text-align: center; color: var(--color-gray-dark); margin-bottom: 30px;">Přihlaste se do svého účtu a začněte psát články</p>
    <!-- Po 5 dnech se v tom konecne vyznam :) -->
    <div class="form-box">
        {control signInForm}
    </div>
</div>
