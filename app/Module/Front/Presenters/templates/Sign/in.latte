{block content}
<div class="auth-container">
    <h1 n:block=title>Přihlášení</h1>
    <p style="color: var(--text-light-gray); margin-bottom: 2rem; text-align: center;">Přihlaste se do svého účtu a začněte psát články</p>
    
    <div class="form-box" style="max-width: 500px;">
        <div class="post-bottom-left"></div>
        <div class="post-bottom-right"></div>
        
        {control signInForm}
    </div>
</div>

<style>
.auth-container {
    max-width: 600px;
    margin: 0 auto;
}
</style>
