{block content}

<div class="auth-container" style="max-width: 600px; margin: 0 auto; animation: slideInBrutal 0.6s ease-out;">
    <h1 n:block=title style="margin-bottom: 15px;">PŘIHLÁŠENÍ</h1>
    <p style="text-align: center; color: var(--color-black); margin-bottom: 40px; font-size: 1.1rem; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">PŘIHLASTE SE A ZAČNĚTE PSÁT</p>
    
    <div class="form-box">
        {control signInForm}
    </div>
</div>
