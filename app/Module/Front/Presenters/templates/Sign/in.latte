{block content}

<div class="auth-container" style="max-width: 600px; margin: 0 auto; animation: slideInUp 0.6s ease-out;">
    <h1 n:block=title style="margin-bottom: 15px;">🔐 Přihlášení</h1>
    <p style="text-align: center; color: var(--color-gray-medium); margin-bottom: 40px; font-size: 1.05rem;">Přihlaste se do svého účtu a začněte psát články</p>
    
    <div class="form-box">
        {control signInForm}
    </div>
</div>
