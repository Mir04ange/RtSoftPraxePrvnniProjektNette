{block content}
<head>

    <style>
        .kls{
            color:black;
            transition: 0.4s;
            border: 1px solid midnightblue;
            padding: 12px
        }
        .kls:hover{
            text-decoration: none;
            background-color: black;
            color: white;
            padding: 17px;
            border-radius: 45% 20px 20px 45%
        }

    </style>
</head>
    <div class="container">
        <p><a class="kls" n:href="Homepage:default"> Zpět na výpis příspěvků</a></p>

        <article class="post" style="margin-top: 1rem;">
            <div class="date">{$post->created_at|date:'j. n. Y'}</div>
            <h1>{$post->title}</h1>
            <div class="post-content" style="margin-top: 1rem;">
                {$post->content}
            </div>
        </article>

        <h2><strong>Komentáře</strong></h2>
        <div class="comments-list">
            {foreach $comments as $comment}
                <div class="comment-item">
                    <div class="comment-meta">
                        <b>{$comment->name}</b> <span style="color: var(--text-muted);">napsal:</span>
                    </div>
                    <div class="comment-content">
                        {$comment->content}
                    </div>
                </div>
            {/foreach}
        </div>

        <div class="form-box">
            <h3>Přidat komentář</h3>
            {control commentForm}
        </div>
    </div>