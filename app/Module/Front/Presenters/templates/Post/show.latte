{block content}
<div class="post-header" style="margin-bottom: 30px; animation: slideInBrutal 0.6s ease-out;">
    <a style="text-decoration: none; color: var(--color-black); font-weight: 900; transition: all 0.3s ease; display: inline-block; padding: 10px 15px; border: 3px solid var(--color-black); background: var(--color-gray); text-transform: uppercase; letter-spacing: 1px;" class="kls" n:href="Homepage:default">
        ← ZPĚT
    </a>
</div>

<article class="post">
    <div class="post-icon" style="top: 20px; right: 30px; font-size: 4rem;">📖</div>

    <div class="post-content">
        <span class="date">{$post->createdAt|date:'j. n. Y'}</span>
        <h1 style="text-align: left; margin-bottom: 20px; margin-top: 10px; font-size: 2.8rem; text-transform: uppercase; border: none; background: transparent; box-shadow: none; transform: none; padding: 0;">{$post->title}</h1>
        
        <div class="post-content" style="color: var(--color-black); line-height: 1.8; margin: 25px 0; font-size: 1.05rem;">
            {$post->content}
        </div>

        <div style="margin-top: 30px; display: flex; gap: 15px; flex-wrap: wrap;" n:if="$user->isLoggedIn()">
            <a class="btn" n:href="Edit:edit $post->id">UPRAVIT</a>
            <a class="btn" n:href="Edit:delete $post->id" onclick="return confirm('Opravdu chcete smazat tento příspěvek včetně komentářů?')" style="background: var(--color-accent); color: var(--color-white);">SMAZAT</a>
        </div>
    </div>
</article>

<section class="comments-section" style="margin-top: 50px;">
    <h2 style="margin-bottom: 30px; font-size: 2rem; text-transform: uppercase; border: 4px solid var(--color-black); border-top: none; border-right: none; border-left: none; padding-bottom: 15px;">KOMENTÁŘE</h2>

    <div class="comments-list">
        {foreach $comments as $comment}
            <article class="comment-item" style="animation: slideInBrutal 0.6s ease-out;">
                <p class="comment-meta">
                    <strong>
                        <a href="mailto:{$comment->email}" n:tag-if="$comment->email" style="color: var(--color-black); text-decoration: none; text-transform: uppercase;">{$comment->name}</a>
                    </strong>
                    <span style="color: var(--color-dark-gray); font-size: 0.85rem; margin-left: 10px;">
                        {$comment->createdAt|date:'j. n. Y H:i'}
                    </span>
                </p>
                <div style="color: var(--color-black); margin-top: 10px; line-height: 1.6;">
                    {$comment->content}
                </div>
                <p style="margin-top: 12px;" n:if="$user->isLoggedIn()">
                    <a class="kls" n:href="Post:editComment $post->id, $comment->id">UPRAVIT</a>
                    <span style="color: var(--color-black); margin: 0 8px; font-weight: bold;">|</span>
                    <a class="kls" n:href="Post:deleteComment $post->id, $comment->id" onclick="return confirm('Opravdu chcete smazat tento komentář?')" style="color: var(--color-accent);">SMAZAT</a>
                </p>
            </article>
        {else}
            <div class="post" style="text-align: center; padding: 40px; background: var(--color-yellow);">
                <p style="font-size: 1.3rem; color: var(--color-black); font-weight: bold; text-transform: uppercase;">
                    ZATÍM ŽÁDNÉ KOMENTÁŘE. BUĎTE PRVNÍ!
                </p>
            </div>
        {/foreach}
    </div>

    <div class="form-box" style="margin-top: 40px;">
        <h3 style="margin-bottom: 20px; font-size: 1.3rem; color: var(--color-black); text-transform: uppercase;">PŘIDAT KOMENTÁŘ</h3>
        {control commentForm}
    </div>
</section>
