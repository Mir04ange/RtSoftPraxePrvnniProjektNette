{block content}
<div class="post-header" style="margin-bottom: 30px;">
    <a class="kls" n:href="Homepage:default">← Zpět na výpis příspěvků</a>
</div>

<article class="post">
    <div class="post-bottom-left"></div>
    <div class="post-bottom-right"></div>
    
    <span class="date">{$post->created_at|date:'j. n. Y'}</span>
    <h1 style="text-align: left; margin-bottom: 20px;">{$post->title}</h1>
    <div class="post-content">
        {$post->content}
    </div>
    
    <div style="margin-top: 30px; text-align: right;">
        <a class="btn" n:href="Edit:edit $post->id">✏️ Upravit</a>
    </div>
</article>

<section class="comments-section">
    <h2>Komentáře</h2>
    
    <div class="comments-list">
        {foreach $comments as $comment}
            <div class="comment-item">
                <div class="comment-meta">
                    <b>{$comment->name}</b> napsal:
                </div>
                <div class="comment-content">
                    {$comment->content}
                </div>
            </div>
        {/foreach}
    </div>

    <div class="form-box">
        <h3>Přidat komentář</h3>
        {control commentForm}
    </div>
</section>
