{block content}
<div class="edit-container" style="max-width: 800px; margin: 0 auto; animation: slideInUp 0.6s ease-out;">
    <h1 style="margin-bottom: 15px;">✨ Nový příspěvek</h1>
    <p style="text-align: center; color: var(--color-gray-medium); margin-bottom: 40px; font-size: 1.05rem;">Sdílejte své myšlenky a zkušenosti s ostatními</p>
    
    <div class="form-box">
        {control postForm}
    </div>
</div>
