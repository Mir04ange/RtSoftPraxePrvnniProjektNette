{block content}
<div class="edit-container" style="max-width: 800px; margin: 0 auto; animation: slideInBrutal 0.6s ease-out;">
    <h1 style="margin-bottom: 15px;">UPRAVIT PŘÍSPĚVEK</h1>
    <p style="text-align: center; color: var(--color-black); margin-bottom: 40px; font-size: 1.1rem; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">AKTUALIZUJTE OBSAH</p>
    
    <div class="form-box">
        {control postForm}
    </div>
</div>
