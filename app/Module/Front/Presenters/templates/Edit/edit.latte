{block content}
<div class="edit-container">
    <h1>Upravit příspěvek</h1>
    <p style="color: var(--text-light-gray); margin-bottom: 2rem; text-align: center;">Aktualizujte obsah vašeho příspěvku</p>
    
    <div class="form-box">
        <div class="post-bottom-left"></div>
        <div class="post-bottom-right"></div>
        
        {control postForm}
    </div>
</div>

<style>
.edit-container {
    max-width: 800px;
    margin: 0 auto;
}
</style>
